# Ambiente
NODE_ENV=development

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://obracontrol:obracontrol123@localhost:5432/obracontrol?schema=public"

# Auth.js Secret (gere com: openssl rand -base64 32)
AUTH_SECRET="sua-chave-secreta-aqui-gere-com-openssl-rand-base64-32"

# URL pública da aplicação
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Diretório de uploads locais
UPLOAD_DIR="./public/uploads"
NEXT_PUBLIC_UPLOAD_URL="/uploads"

# Tamanho máximo de arquivo (em bytes) - 50MB
MAX_FILE_SIZE=52428800

# Configurações futuras (não obrigatórias agora)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=
# CLOUDFLARE_R2_ENDPOINT=
# AZURE_STORAGE_CONNECTION_STRING=
